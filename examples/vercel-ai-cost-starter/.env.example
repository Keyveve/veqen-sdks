# The public demo needs no keys and makes no model calls.
# Set BOTH values to enable the protected live endpoint in your own deployment.
OPENAI_API_KEY=
# Use a random access token of at least 32 characters. Never use NEXT_PUBLIC_ for secrets.
DEMO_ACCESS_TOKEN=
# Optional send-only Veqen key for real calls. No example fixtures are sent.
VEQEN_API_KEY=
